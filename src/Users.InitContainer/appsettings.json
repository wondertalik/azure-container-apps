{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Azure.Cosmos": "Warning"
    }
  },
  "OTEL_SERVICE_NAME": "UsersInitContainer",
  "OTEL_SERVICE_VERSION": "1.0.0",
  "OTELCOL_URL": "",
  "OtelOltpTracingOptions": {
    "ConsoleExporter": false
  },
  "OtelOltpMetricsOptions": {
    "ConsoleExporter": false
  },
  "OtelOltpLogsOptions": {
    "ConsoleExporter": false
  },
  "UsersDropDatabaseIfExists": false,
  "Users": {
    "UsersInfrastructureCosmosDbOptions": {
      "DatabaseId": "users-db",
      "Throughput": 400,
      "UseIntegratedCache": false,
      "IgnoreSslCertificateValidation": false
    }
  },
  "SeederOptions": {
    "TenantsSeed": false,
    "UsersSeed": false,
    "SeedDataFilePath": "/app/seed-data"
  }
}
